[
    {
        "rule_id": "RULE_HW_001",
        "description": "Detect Card Reader Jam",
        "priority": 10,
        "conditions": [
            {
                "fact": "card_reader_status",
                "operator": "eq",
                "value": "JAMMED"
            },
            {
                "fact": "error_code",
                "operator": "contains",
                "value": "3A1"
            }
        ],
        "actions": [
            {
                "action": "assert",
                "fact": "diagnosis",
                "value": "HW_001"
            },
            {
                "action": "assert",
                "fact": "requires_engineer",
                "value": true
            }
        ]
    },
    {
        "rule_id": "RULE_HW_002",
        "description": "Detect Dirty Card Reader",
        "priority": 5,
        "conditions": [
            {
                "fact": "card_reader_status",
                "operator": "eq",
                "value": "DIRTY_SENSOR"
            }
        ],
        "actions": [
            {
                "action": "assert",
                "fact": "diagnosis",
                "value": "HW_002"
            },
            {
                "action": "assert",
                "fact": "self_recoverable",
                "value": true
            }
        ]
    },
    {
